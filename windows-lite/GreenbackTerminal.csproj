<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GreenbackTerminal</AssemblyName>
    <RootNamespace>GreenbackTerminal</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Greenback Terminal</Product>
    <Company>Greenback Terminal</Company>
    <Description>Greenback Terminal for Windows</Description>
    <Copyright>Greenback Terminal</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Filled by the build workflow: the 3 small WebView2 files, packed inside the .exe -->
    <EmbeddedResource Include="payload\*.dll" LogicalName="payload.%(Filename)%(Extension)" />
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
  </ItemGroup>
</Project>
